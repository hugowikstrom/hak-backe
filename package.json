{
  "name": "hak-backe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch server/index.mjs",
    "dev:web": "vite --config web/vite.config.js",
    "build": "node scripts/rensa-dist.mjs && npm run build:webb && npm run build:mobil && npm run build:kiosk",
    "start": "node server/index.mjs",
    "fro": "node server/fro.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm test && npm run build",
    "build:webb": "vite build --config web/vite.config.js",
    "build:mobil": "vite build --config web/mobil/vite.config.js",
    "dev:mobil": "vite --config web/mobil/vite.config.js",
    "build:kiosk": "vite build --config web/kiosk/vite.config.js",
    "dev:kiosk": "vite --config web/kiosk/vite.config.js",
    "ny-forening": "node scripts/ny-forening.mjs",
    "foreningar": "node scripts/foreningar.mjs"
  },
  "dependencies": {
    "nodemailer": "^7.0.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.1.12"
  }
}
